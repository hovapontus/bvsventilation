---
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/work-sans/latin-400.css';
import '@fontsource/work-sans/latin-500.css';
import '../styles/global.css';
import logo from '../assets/logo.svg';
import badge from '../assets/ventlo-badge.svg';
import Cta from '../components/Cta.astro';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
}
const { title, description, ogType = 'article' } = Astro.props;
const site = 'https://bvsventilation.se';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = `${site}/og-image.jpg`;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Hem' },
  { href: '/omoss/', label: 'Om oss' },
  { href: '/tjanster/', label: 'Tjänster' },
  { href: '/kontakt/', label: 'Kontakt' },
];
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="BVS VENTILATION" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'HVACBusiness',
      name: 'BVS VENTILATION',
      url: site,
      telephone: '+46703965353',
      email: 'info@bvsventilation.se',
      address: { '@type': 'PostalAddress', streetAddress: 'Hova 205', postalCode: '451 91', addressLocality: 'Uddevalla', addressCountry: 'SE' },
    })} />
  </head>
  <body>
    <a class="skip-link" href="#content">Hoppa till innehåll</a>
    <header class="site-header">
      <div class="container">
        <a class="logo" href="/" aria-label="BVS VENTILATION – Hem"><img src={logo.src} width="190" height="69" alt="BVS VENTILATION" /></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav" aria-label="Meny">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13h18a1 1 0 0 0 0-2H3a1 1 0 0 0 0 2zm0-6h18a1 1 0 0 0 0-2H3a1 1 0 0 0 0 2zm0 12h18a1 1 0 0 0 0-2H3a1 1 0 0 0 0 2z"/></svg>
        </button>
        <nav aria-label="Huvudmeny">
          <ul class="nav" id="nav">
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <Cta />

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h2>BVS VENTILATION</h2>
            <address>
              <p><strong>Address</strong><br />Hova 205, 451 91, Uddevalla</p>
              <p><strong>Mail</strong><br /><a href="mailto:info@bvsventilation.se">info@bvsventilation.se</a></p>
              <p><strong>Telefon</strong><br /><a href="tel:+46703965353">+46 703 96 53 53</a></p>
            </address>
            <p class="copyright">Copyright © 2026 BVS VENTILATION</p>
          </div>
          <div></div>
          <div>
            <a href="https://ventlo.io" target="_blank" rel="noopener"><img class="badge" src={badge.src} width="220" height="72" alt="Verifierad av Ventlo" loading="lazy" /></a>
            <iframe class="footer-map" title="Karta över BVS Ventilation" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2246.2791004164574!2d11.896566677001896!3d58.30629849248555!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x46450e24dc7fd49f%3A0x9c8939b320925290!2sBVS%20Ventilation!5e1!3m2!1ssv!2sse!4v1758579334507!5m2!1ssv!2sse"></iframe>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      const btn = document.querySelector('.menu-toggle');
      const nav = document.getElementById('nav');
      btn.addEventListener('click', () => {
        const open = nav.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
